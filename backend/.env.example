NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bricky_app
DB_PASS=replace-me
DB_NAME=bricky
TYPEORM_SYNCHRONIZE=false

# Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated. Production defaults to the two HTTPS Bricky domains.
CORS_ORIGINS=http://localhost:5173

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Bricky <no-reply@bricky.bg>
