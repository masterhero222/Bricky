NODE_ENV=development
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<MYSQL_USER>
DB_PASS=<MYSQL_PASSWORD>
DB_NAME=bricky
TYPEORM_SYNCHRONIZE=false

# JWT
JWT_SECRET=<LONG_RANDOM_JWT_SECRET>

# Public frontend URL used inside verification and password-reset emails.
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Transactional email provider.
# Never commit real SMTP credentials.
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USER=<SMTP_USERNAME>
MAIL_PASS=<SMTP_PASSWORD>
MAIL_FROM="Bricky <no-reply@bricky.bg>"

# Uploads
UPLOADS_DIR=uploads
